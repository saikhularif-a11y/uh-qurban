        function filterReview(mode) {
            const btnAll = document.getElementById('btnFilterAll');
            const btnWrong = document.getElementById('btnFilterWrong');

            if (mode === 'ALL') {
                btnAll.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-gray-800 text-white transition";
                btnWrong.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-gray-100 text-gray-700 hover:bg-gray-200 transition";
            } else {
                btnWrong.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-dafi-red text-white transition";
                btnAll.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-gray-100 text-gray-700 hover:bg-gray-200 transition";
            }
            renderDetailedReview(mode);
        }

        function renderDetailedReview(filterMode) {
            const container = document.getElementById('reviewContainer');
            container.innerHTML = '';

            const evalDetails = quizState.evaluationResult.details;

            // Tampilkan berurutan berdasarkan nomor soal asli 1 s.d. 25
            const itemsToRender = QUESTION_BANK.filter(q => {
                if (filterMode === 'WRONG') {
                    return !evalDetails[q.id].isCorrect;
                }
                return true;
            });

            if (itemsToRender.length === 0) {
                container.innerHTML = `
                    <div class="p-8 text-center bg-emerald-50 rounded-2xl border border-emerald-200 text-emerald-800">
                        <i class="fa-solid fa-circle-check text-3xl text-emerald-600 mb-2"></i>
                        <p class="font-extrabold text-base">Masyaallah, Sempurna! Tidak Ada Jawaban yang Salah.</p>
                        <p class="text-xs mt-1">Seluruh 25 soal berhasil kamu jawab dengan tepat.</p>
                    </div>
                `;
                return;
            }

            itemsToRender.forEach(q => {
                const info = evalDetails[q.id];
                const isCorrect = info.isCorrect;

                const card = document.createElement('div');
                card.className = `rounded-2xl border p-5 transition ${
                    isCorrect ? 'bg-white border-gray-200' : 'bg-red-50/40 border-red-200'
                }`;

                let optionsHtml = '';
                ['A', 'B', 'C', 'D'].forEach(letter => {
                    const isKey = (info.correctKey === letter);
                    const isStudentChoice = (info.studentAnswer === letter);

                    let optStyle = "border-gray-200 bg-gray-50 text-gray-600";
                    let badgeHtml = "";

                    if (isKey) {
                        optStyle = "border-emerald-500 bg-emerald-50 text-emerald-900 font-bold";
                        badgeHtml = `<span class="ml-auto text-[11px] font-extrabold bg-emerald-600 text-white px-2 py-0.5 rounded">Kunci Jawaban</span>`;
                    } else if (isStudentChoice && !isKey) {
                        optStyle = "border-red-400 bg-red-100/70 text-red-900 font-semibold";
                        badgeHtml = `<span class="ml-auto text-[11px] font-extrabold bg-dafi-red text-white px-2 py-0.5 rounded">Jawabanmu</span>`;
                    }

                    optionsHtml += `
                        <div class="p-3 rounded-xl border text-xs sm:text-sm flex items-center gap-2.5 ${optStyle}">
                            <span class="w-6 h-6 rounded-md font-bold flex items-center justify-center shrink-0 ${
                                isKey ? 'bg-emerald-600 text-white' : (isStudentChoice ? 'bg-dafi-red text-white' : 'bg-white border border-gray-300 text-gray-700')
                            }">${letter}</span>
                            <span>${q.options[letter]}</span>
                            ${badgeHtml}
                        </div>
                    `;
                });

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-gray-800 text-white">
                            Soal #${q.id}
                        </span>
                        <span class="text-xs font-extrabold px-3 py-1 rounded-full flex items-center gap-1.5 ${
                            isCorrect ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-dafi-red'
                        }">
                            <i class="fa-solid ${isCorrect ? 'fa-check' : 'fa-xmark'}"></i>
                            ${isCorrect ? 'Benar (+4 Poin)' : `Salah (Jawabanmu: ${info.studentAnswer}, Kunci: ${info.correctKey})`}
                        </span>
                    </div>

                    <p class="font-bold text-gray-900 text-sm sm:text-base mb-3.5 leading-relaxed">
                        ${q.question}
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-4">
                        ${optionsHtml}
                    </div>

                    <div class="bg-blue-50/80 border border-blue-200 rounded-xl p-3.5 text-xs sm:text-sm text-blue-950">
                        <span class="font-extrabold text-blue-800 block mb-0.5">
                            <i class="fa-solid fa-lightbulb mr-1 text-amber-500"></i> Pembahasan Fikih:
                        </span>
                        ${info.explanation}
                    </div>
                `;

                container.appendChild(card);
            });
        }

        function openConfigModal() {
            const modal = document.getElementById('modalConfig');
            const input = document.getElementById('inputScriptUrl');
            input.value = getActiveScriptUrl();
            document.getElementById('configSavedNotice').classList.add('hidden');
            document.getElementById('testConnectionResult').classList.add('hidden');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfigModal() {
            const modal = document.getElementById('modalConfig');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveScriptUrlConfig() {
            const input = document.getElementById('inputScriptUrl');
            const url = input.value.trim();
            try {
                if (url) {
                    localStorage.setItem('DAFI_PAI_SCRIPT_URL', url);
                } else {
                    localStorage.removeItem('DAFI_PAI_SCRIPT_URL');
                }
            } catch (e) {
                // Ignore storage errors
            }
            updateConnectionBadgeUI();
            const notice = document.getElementById('configSavedNotice');
            notice.classList.remove('hidden');

            // Jika sedang berada di halaman hasil dan sebelumnya belum terkirim, otomatis coba kirim
            if (quizState.isSubmitted && !quizState.syncSuccess && url) {
                submitQuizToGoogleSheets();
            }
        }

        async function sendSampleTestToSheets() {
            const input = document.getElementById('inputScriptUrl');
            const url = input.value.trim();
            const resultBox = document.getElementById('testConnectionResult');
            const btnTest = document.getElementById('btnTestConnection');

            if (!url || !url.startsWith('https://script.google.com/')) {
                resultBox.className = "mt-3 p-3 rounded-xl text-xs font-semibold bg-red-50 border border-red-200 text-dafi-red";
                resultBox.textContent = "Masukkan URL Web App Google Apps Script yang valid (diawali https://script.google.com/.../exec) terlebih dahulu.";
                resultBox.classList.remove('hidden');
                return;
            }

            // Simpan terlebih dahulu
            saveScriptUrlConfig();

            btnTest.disabled = true;
            btnTest.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> Mengirim Uji Coba...`;
            resultBox.className = "mt-3 p-3 rounded-xl text-xs font-semibold bg-blue-50 border border-blue-200 text-blue-800";
            resultBox.textContent = "Sedang mengirim 1 baris data santri contoh ke Google Sheets...";
            resultBox.classList.remove('hidden');

            // Buat data uji coba dengan jawaban contoh (23 benar, 2 salah -> Nilai 92 TUNTAS)
            const sampleAnswers = {
                q1: "B", q2: "C", q3: "A", q4: "D", q5: "B",
                q6: "C", q7: "A", q8: "D", q9: "B", q10: "C",
                q11: "A", q12: "D", q13: "B", q14: "C", q15: "A",
                q16: "D", q17: "B", q18: "C", q19: "A", q20: "D",
                q21: "B", q22: "C", q23: "A", q24: "A", q25: "A"
            };

            const testPayload = {
                submissionId: "TEST-" + Date.now(),
                studentName: "SANTRI CONTOH (UJI COBA GURU)",
                studentClass: "9A",
                totalQuestions: 25,
                answers: sampleAnswers
            };

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(testPayload),
                    redirect: 'follow'
                });

                const resJson = await response.json();
                if (resJson && resJson.status === 'success') {
                    resultBox.className = "mt-3 p-3 rounded-xl text-xs font-semibold bg-emerald-50 border border-emerald-300 text-emerald-900";
                    resultBox.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> <strong>Berhasil!</strong> Data contoh (Nilai: ${resJson.data.score}, Status: ${resJson.data.status}) telah masuk ke sheet <strong>Hasil Kuis</strong> baris ke-${resJson.data.rowNumber}. Silakan periksa Google Sheets Anda!`;
                } else {
                    throw new Error(resJson?.message || "Gagal memproses di server.");
                }
            } catch (err) {
                resultBox.className = "mt-3 p-3 rounded-xl text-xs font-semibold bg-red-50 border border-red-200 text-dafi-red";
                resultBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> <strong>Gagal Terhubung:</strong> ${err.message}. Pastikan Deployment diatur ke <em>Who has access: Anyone</em>.`;
            } finally {
                btnTest.disabled = false;
                btnTest.innerHTML = `<i class="fa-solid fa-vial text-dafi-red"></i> <span>Kirim Data Uji Coba</span>`;
            }
        }

        // Inisialisasi saat halaman dimuat
        window.onload = function () {
            updateConnectionBadgeUI();
        };
    </script>
</body>
</html>
