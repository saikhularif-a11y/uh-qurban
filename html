        function clearValidationErrors() {
            document.getElementById('errStudentName').classList.add('hidden');
            document.getElementById('errStudentClass').classList.add('hidden');
            document.getElementById('inputStudentName').classList.remove('border-dafi-red', 'ring-2', 'ring-dafi-red/20');
        }

        function handleStartQuiz(event) {
            event.preventDefault();
            clearValidationErrors();

            const nameInput = document.getElementById('inputStudentName');
            const rawName = nameInput.value.trim();
            const selectedClassRadio = document.querySelector('input[name="studentClass"]:checked');

            let isValid = true;

            if (!rawName || rawName.length < 3) {
                document.getElementById('errStudentName').classList.remove('hidden');
                nameInput.classList.add('border-dafi-red', 'ring-2', 'ring-dafi-red/20');
                nameInput.focus();
                isValid = false;
            }

            if (!selectedClassRadio || !['9A', '9B', '9C'].includes(selectedClassRadio.value)) {
                document.getElementById('errStudentClass').classList.remove('hidden');
                isValid = false;
            }

            if (!isValid) return;

            // Inisialisasi sesi kuis baru dengan urutan soal diacak
            quizState = {
                submissionId: generateSubmissionId(),
                studentName: rawName,
                studentClass: selectedClassRadio.value,
                shuffledQuestions: shuffleArray(QUESTION_BANK),
                currentIndex: 0,
                answersByOriginalId: {},
                isSubmitted: false,
                isSending: false,
                syncSuccess: false,
                submittedAtText: "",
                evaluationResult: null
            };

            // Tampilkan identitas siswa di header
            document.getElementById('headerStudentName').textContent = quizState.studentName;
            document.getElementById('headerStudentClass').textContent = quizState.studentClass;
            document.getElementById('activeStudentBadge').classList.remove('hidden');
            document.getElementById('activeStudentBadge').classList.add('md:flex');
            document.getElementById('mobileStudentIdentity').textContent = `${quizState.studentName} (${quizState.studentClass})`;

            // Beralih tampilan dari Start ke Quiz
            document.getElementById('viewStart').classList.add('hidden');
            document.getElementById('viewResult').classList.add('hidden');
            document.getElementById('viewQuiz').classList.remove('hidden');

            renderQuestionGridNav();
            renderCurrentQuestion();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderCurrentQuestion() {
            const total = quizState.shuffledQuestions.length;
            const currentQ = quizState.shuffledQuestions[quizState.currentIndex];
            const displayNum = quizState.currentIndex + 1;
            const selectedOption = quizState.answersByOriginalId[currentQ.id] || null;
            const answeredCount = Object.keys(quizState.answersByOriginalId).length;

            // Update Progress Bar & Indikator
            document.getElementById('quizProgressBadge').textContent = `Soal ${displayNum} dari ${total}`;
            document.getElementById('answeredCountBadge').textContent = `Terjawab: ${answeredCount}/${total}`;
            const progressPercent = Math.round((answeredCount / total) * 100);
            document.getElementById('quizProgressBar').style.width = `${Math.max(4, progressPercent)}%`;

            // Update Header Nomor Soal
            document.getElementById('currentDisplayNumber').textContent = displayNum;
            const statusPill = document.getElementById('questionAnsweredStatus');
            if (selectedOption) {
                statusPill.textContent = `Terjawab (${selectedOption})`;
                statusPill.className = "text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700";
            } else {
                statusPill.textContent = "Belum Dijawab";
                statusPill.className = "text-xs font-bold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500";
            }

            // Update Redaksi Soal
            document.getElementById('questionText').textContent = currentQ.question;

            // Render Opsi A, B, C, D
            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';

            ['A', 'B', 'C', 'D'].forEach(letter => {
                const isSelected = selectedOption === letter;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `option-card w-full text-left p-4 rounded-xl border-2 flex items-start gap-3.5 cursor-pointer ${
                    isSelected
                        ? 'selected border-dafi-red bg-dafi-lightred'
                        : 'border-gray-200 bg-white'
                }`;
                btn.onclick = () => selectAnswer(currentQ.id, letter);

                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-lg font-extrabold text-sm flex items-center justify-center shrink-0 transition ${
                        isSelected
                            ? 'bg-dafi-red text-white shadow-xs'
                            : 'bg-gray-100 text-gray-700 border border-gray-300'
                    }">
                        ${letter}
                    </span>
                    <span class="text-sm sm:text-base font-medium leading-relaxed pt-0.5 ${
                        isSelected ? 'text-gray-900 font-bold' : 'text-gray-700'
                    }">
                        ${currentQ.options[letter]}
                    </span>
                `;
                optionsContainer.appendChild(btn);
            });

            // Atur tombol Sebelumnya & Selanjutnya
            document.getElementById('btnPrevQuestion').disabled = (quizState.currentIndex === 0);
            const btnNext = document.getElementById('btnNextQuestion');
            if (quizState.currentIndex === total - 1) {
                btnNext.innerHTML = `<span>Ke Soal Pertama</span> <i class="fa-solid fa-rotate-left text-xs"></i>`;
            } else {
                btnNext.innerHTML = `<span>Selanjutnya</span> <i class="fa-solid fa-chevron-right text-xs"></i>`;
            }

            updateQuestionGridHighlight();
        }

        function renderQuestionGridNav() {
            const grid = document.getElementById('questionGridNav');
            grid.innerHTML = '';

            quizState.shuffledQuestions.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `navDot-${idx}`;
                btn.onclick = () => jumpToQuestion(idx);
                btn.textContent = idx + 1;
                grid.appendChild(btn);
            });

            updateQuestionGridHighlight();
        }

        function updateQuestionGridHighlight() {
            const total = quizState.shuffledQuestions.length;
            const answeredCount = Object.keys(quizState.answersByOriginalId).length;
            const remaining = total - answeredCount;

            const counterEl = document.getElementById('unansweredCounterText');
            if (remaining === 0) {
                counterEl.textContent = "Semua 25 soal terjawab!";
                counterEl.className = "text-xs font-bold text-emerald-600";
                document.getElementById('incompleteNotice').classList.add('hidden');
            } else {
                counterEl.textContent = `${remaining} belum dijawab`;
                counterEl.className = "text-xs font-semibold text-dafi-red";
            }

            quizState.shuffledQuestions.forEach((q, idx) => {
                const btn = document.getElementById(`navDot-${idx}`);
                if (!btn) return;
                const isAnswered = Boolean(quizState.answersByOriginalId[q.id]);
                const isCurrent = (idx === quizState.currentIndex);

                let baseClasses = "nav-dot h-10 rounded-xl font-bold text-xs flex items-center justify-center cursor-pointer ";
                if (isAnswered) {
                    baseClasses += "bg-dafi-red text-white shadow-xs ";
                } else {
                    baseClasses += "bg-gray-100 text-gray-700 border border-gray-300 hover:bg-gray-200 ";
                }

                if (isCurrent) {
                    baseClasses += "ring-2 ring-offset-2 ring-gray-900 font-extrabold ";
                }

                btn.className = baseClasses;
            });
        }

        function selectAnswer(originalQuestionId, optionLetter) {
            if (quizState.isSubmitted) return;
            quizState.answersByOriginalId[originalQuestionId] = optionLetter;
            renderCurrentQuestion();
        }

        function navigateQuestion(direction) {
            const total = quizState.shuffledQuestions.length;
            let nextIdx = quizState.currentIndex + direction;
            if (nextIdx >= total) nextIdx = 0;
            if (nextIdx < 0) nextIdx = 0;
            quizState.currentIndex = nextIdx;
            renderCurrentQuestion();
        }

        function jumpToQuestion(index) {
            quizState.currentIndex = index;
            renderCurrentQuestion();
        }

        function handleRequestSubmit() {
            if (quizState.isSubmitted) return;

            // Cari apakah masih ada soal yang belum dijawab
            const unansweredIndices = [];
            quizState.shuffledQuestions.forEach((q, idx) => {
                if (!quizState.answersByOriginalId[q.id]) {
                    unansweredIndices.push(idx);
                }
            });

            if (unansweredIndices.length > 0) {
                const firstUnansweredIdx = unansweredIndices[0];
                const displayNums = unansweredIndices.map(i => i + 1).join(', ');
                const noticeBox = document.getElementById('incompleteNotice');
                const noticeText = document.getElementById('incompleteNoticeText');

                noticeText.textContent = `Wajib menjawab semua soal! Masih ada ${unansweredIndices.length} soal belum dijawab (Nomor: ${displayNums}).`;
                noticeBox.classList.remove('hidden');

                // Arahkan siswa langsung ke soal pertama yang belum dijawab
                jumpToQuestion(firstUnansweredIdx);
                return;
            }

            // Semua 25 soal sudah dijawab -> Tampilkan Modal Konfirmasi
            document.getElementById('confirmModalName').textContent = quizState.studentName;
            document.getElementById('confirmModalClass').textContent = quizState.studentClass;
            const modal = document.getElementById('modalConfirmSubmit');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('modalConfirmSubmit');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function executeFinalSubmit() {
            if (quizState.isSubmitted) return;
            closeConfirmModal();

            // Kunci sesi kuis agar tidak dapat diubah lagi
            quizState.isSubmitted = true;
            const now = new Date();
            quizState.submittedAtText = now.toLocaleString('id-ID', {
                dateStyle: 'full',
                timeStyle: 'medium'
            });

            // Hitung nilai sesungguhnya dari 25 jawaban siswa
            quizState.evaluationResult = evaluateSubmittedQuizLocally(quizState.answersByOriginalId);

            // Tampilkan Halaman Hasil & Pembahasan
            document.getElementById('viewQuiz').classList.add('hidden');
            document.getElementById('viewResult').classList.remove('hidden');

            renderResultSummary();
            renderDetailedReview('ALL');
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Kirim data ke Google Sheets
            submitQuizToGoogleSheets();
        }

        function buildSubmissionPayload() {
            // Susun jawaban berurutan dari Soal 1 s.d. Soal 25 sesuai urutan Bank Soal Asli
            const orderedAnswers = {};
            for (let i = 1; i <= 25; i++) {
                orderedAnswers[`q${i}`] = quizState.answersByOriginalId[i] || "";
            }

            return {
                submissionId: quizState.submissionId,
                studentName: quizState.studentName,
                studentClass: quizState.studentClass,
                totalQuestions: 25,
                clientCorrectCount: quizState.evaluationResult.correctCount,
                clientWrongCount: quizState.evaluationResult.wrongCount,
                clientScore: quizState.evaluationResult.finalScore,
                clientStatus: quizState.evaluationResult.status,
                answers: orderedAnswers
            };
        }

        async function submitQuizToGoogleSheets() {
            // Cegah klik/pengiriman ganda ketika pengiriman sedang berlangsung atau sudah berhasil
            if (quizState.isSending || quizState.syncSuccess) return;

            const scriptUrl = getActiveScriptUrl();
            const banner = document.getElementById('syncStatusBanner');

            if (!scriptUrl) {
                banner.className = "rounded-2xl p-4 sm:p-5 border bg-amber-50 border-amber-300 text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4";
                banner.innerHTML = `
                    <div class="flex items-start gap-3">
                        <i class="fa-solid fa-triangle-exclamation text-amber-600 text-xl mt-0.5"></i>
                        <div>
                            <h4 class="font-extrabold text-sm sm:text-base">URL Google Sheets Belum Dikonfigurasi</h4>
                            <p class="text-xs sm:text-sm text-amber-800 mt-0.5">
                                Nilai Anda telah dihitung dengan akurat, namun belum terkirim ke Google Sheets karena URL Web App Guru belum dimasukkan. Pasang URL di menu <strong>Konfigurasi Sheets</strong> lalu klik tombol kirim ulang di samping.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" onclick="openConfigModal()" class="px-3.5 py-2 rounded-xl bg-white border border-amber-400 text-amber-900 font-bold text-xs hover:bg-amber-100 transition cursor-pointer">
                            Atur URL
                        </button>
                        <button type="button" onclick="submitQuizToGoogleSheets()" class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-xs transition flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-rotate-right"></i> Kirim Ulang
                        </button>
                    </div>
                `;
                return;
            }

            quizState.isSending = true;
            banner.className = "rounded-2xl p-4 sm:p-5 border bg-blue-50 border-blue-200 text-blue-900 flex items-center justify-between gap-4";
            banner.innerHTML = `
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-notch fa-spin text-blue-600 text-xl"></i>
                    <div>
                        <h4 class="font-extrabold text-sm sm:text-base">Sedang Menyimpan Nilai ke Google Sheets Guru...</h4>
                        <p class="text-xs text-blue-700 mt-0.5">Mohon tunggu sebentar, jangan tutup halaman ini. ID Pengiriman: <code class="font-mono">${quizState.submissionId}</code></p>
                    </div>
                </div>
            `;

            const payload = buildSubmissionPayload();

            try {
                // Menggunakan Content-Type text/plain;charset=utf-8 agar tidak memicu blokir CORS preflight pada Google Apps Script
                const response = await fetch(scriptUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'text/plain;charset=utf-8'
                    },
                    body: JSON.stringify(payload),
                    redirect: 'follow'
                });

                if (!response.ok) {
                    throw new Error(`HTTP Error ${response.status}`);
                }

                const result = await response.json();

                if (result && result.status === 'success') {
                    quizState.syncSuccess = true;
                    quizState.isSending = false;

                    // Jika server mengembalikan timestamp resmi & hasil validasi server, sinkronkan tampilan
                    if (result.data && result.data.timestamp) {
                        document.getElementById('resultTimestamp').textContent = result.data.timestamp;
                    }

                    banner.className = "rounded-2xl p-4 sm:p-5 border bg-emerald-50 border-emerald-300 text-emerald-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3";
                    banner.innerHTML = `
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <div>
                                <h4 class="font-extrabold text-sm sm:text-base">Alhamdulillah! Hasil Kuis Berhasil Tersimpan di Google Sheets Guru</h4>
                                <p class="text-xs text-emerald-800 mt-0.5">
                                    Server Google Sheets telah memvalidasi dan menyimpan jawaban Anda pada sheet <strong>Hasil Kuis</strong> (Baris ke-${result.data?.rowNumber || '-'}).
                                </p>
                            </div>
                        </div>
                        <span class="text-xs font-mono bg-emerald-100 text-emerald-800 px-3 py-1 rounded-lg border border-emerald-200 shrink-0">
                            Terkonfirmasi Server
                        </span>
                    `;
                } else {
                    throw new Error(result?.message || "Respons server tidak valid.");
                }
            } catch (error) {
                quizState.isSending = false;
                banner.className = "rounded-2xl p-4 sm:p-5 border bg-red-50 border-red-300 text-red-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4";
                banner.innerHTML = `
                    <div class="flex items-start gap-3">
                        <div class="w-9 h-9 rounded-xl bg-dafi-red text-white flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-sm sm:text-base">Gagal Mengirim Data ke Google Sheets</h4>
                            <p class="text-xs text-red-800 mt-0.5">
                                Penyebab: ${error.message || 'Gangguan koneksi internet atau URL Apps Script belum tepat'}. Nilai Anda tetap aman di halaman ini. Silakan periksa koneksi lalu klik tombol <strong>Coba Kirim Lagi</strong>.
                            </p>
                        </div>
                    </div>
                    <button
                        type="button"
                        onclick="submitQuizToGoogleSheets()"
                        class="px-4 py-2.5 rounded-xl dafi-gradient text-white font-extrabold text-xs shadow-sm transition flex items-center gap-2 shrink-0 cursor-pointer"
                    >
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Coba Kirim Lagi</span>
                    </button>
                `;
            }
        }

