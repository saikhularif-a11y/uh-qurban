                [15, "QQ==", "Daging kurban disunahkan untuk dimakan sebagian oleh pekurban, dihadiahkan kepada kerabat/tetangga, dan disedekahkan kepada fakir miskin."],
                [16, "RA==", "Dari Ali bin Abi Thalib r.a., Rasulullah saw. melarang memberikan daging atau kulit hewan kurban sebagai upah jagal; upah harus diambil dari dana pribadi pekurban."],
                [17, "Qg==", "Akikah adalah sembelihan hewan ternak sebagai wujud rasa syukur kepada Allah Swt. atas kelahiran seorang bayi."],
                [18, "Qw==", "Menurut jumhur ulama, hukum melaksanakan akikah bagi orang tua yang mampu adalah sunah muakkadah."],
                [19, "QQ==", "Disunahkan bagi anak laki-laki untuk diakikahi dengan 2 ekor kambing atau domba yang setara."],
                [20, "RA==", "Disunahkan bagi anak perempuan untuk diakikahi dengan 1 ekor kambing atau domba."],
                [21, "Qg==", "Berdasarkan hadis Samurah bin Jundub, waktu paling utama (afdhal) pelaksanaan akikah adalah pada hari ketujuh setelah kelahiran anak."],
                [22, "Qw==", "Karena hukumnya sunah muakkadah bagi yang mampu, keluarga yang belum mampu tidak boleh memaksakan diri berutang dan dapat melaksanakannya ketika sudah dilapangkan rezekinya."],
                [23, "QQ==", "Kurban dilaksanakan pada hari raya Iduladha & hari Tasyrik (10-13 Zulhijah), sedangkan akikah berkaitan dengan rasa syukur atas kelahiran anak."],
                [24, "RA==", "Berbeda dengan daging kurban yang dibagikan mentah, daging akikah lebih utama dimasak terlebih dahulu sebelum dibagikan atau dihidangkan untuk memudahkan penerima."],
                [25, "Qg==", "Ibadah kurban dan akikah menanamkan nilai ketakwaan, keikhlasan, rasa syukur, sifat amanah, serta kepedulian sosial kepada sesama."]
            ];

            let correctCount = 0;
            const details = {};

            encodedKeyMap.forEach(([id, b64Key, explanation]) => {
                const key = atob(b64Key);
                const studentAns = answersMap[id] || "-";
                const isCorrect = (studentAns === key);
                if (isCorrect) correctCount++;
                details[id] = {
                    correctKey: key,
                    studentAnswer: studentAns,
                    isCorrect: isCorrect,
                    explanation: explanation
                };
            });

            const wrongCount = 25 - correctCount;
            const finalScore = correctCount * 4;
            const status = finalScore >= 80 ? "TUNTAS" : "PERLU BELAJAR LAGI";

            return {
                correctCount,
                wrongCount,
                finalScore,
                status,
                details
            };
        }

