<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAFI FIQH QUIZ — Misi Kurban & Akikah</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        dafi: {
                            red: '#C8102E',
                            darkred: '#9B0B22',
                            lightred: '#FDE8EC',
                            gray: '#F4F5F7',
                            darkgray: '#374151'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F4F5F7;
            color: #1F2937;
        }
        .dafi-gradient {
            background: linear-gradient(135deg, #C8102E 0%, #8A081E 100%);
        }
        .option-card {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .option-card:hover:not(.disabled) {
            transform: translateY(-2px);
            border-color: #C8102E;
            background-color: #FFF5F6;
        }
        .option-card.selected {
            border-color: #C8102E;
            background-color: #FDE8EC;
            box-shadow: 0 4px 12px rgba(200, 16, 46, 0.12);
        }
        .nav-dot {
            transition: all 0.15s ease;
        }
        .nav-dot:hover {
            transform: scale(1.08);
        }
        @keyframes pulseSubtle {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.65; }
        }
        .animate-pulse-subtle {
            animation: pulseSubtle 2s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-dafi-red selection:text-white">

    <header class="dafi-gradient text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white text-dafi-red flex items-center justify-center font-extrabold text-xl shadow-md shrink-0">
                    <i class="fa-solid fa-mosque"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded-md">SMP DAFI Kelas IX</span>
                        <span id="connectionBadge" class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-amber-400/20 text-amber-100 border border-amber-300/30 hidden sm:inline-flex items-center gap-1">
                            <i class="fa-solid fa-link-slash text-[10px]"></i> Mode Offline / Belum Dikonfigurasi
                        </span>
                    </div>
                    <h1 class="font-extrabold text-base sm:text-lg tracking-tight leading-tight mt-0.5">
                        DAFI FIQH QUIZ — Misi Kurban & Akikah
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <!-- Student Active Badge during quiz -->
                <div id="activeStudentBadge" class="hidden md:flex items-center gap-2 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-xl text-xs font-medium border border-white/20">
                    <i class="fa-solid fa-user-graduate"></i>
                    <span id="headerStudentName">-</span>
                    <span class="bg-white text-dafi-red font-bold px-1.5 py-0.5 rounded text-[11px]" id="headerStudentClass">-</span>
                </div>

                <!-- Teacher Settings Button -->
                <button id="btnOpenConfig" type="button" onclick="openConfigModal()" title="Pengaturan URL Google Sheets (Guru)" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/25 text-white transition flex items-center gap-1.5 text-xs font-semibold border border-white/15">
                    <i class="fa-solid fa-gear text-sm"></i>
                    <span class="hidden sm:inline">Konfigurasi Sheets</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

        <!-- VIEW 1: HALAMAN AWAL (IDENTITAS & PETUNJUK) -->
        <section id="viewStart" class="max-w-3xl mx-auto">
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
                <!-- Hero Banner -->
                <div class="dafi-gradient p-6 sm:p-8 text-white relative overflow-hidden">
                    <div class="relative z-10">
                        <span class="inline-flex items-center gap-1.5 bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full mb-3">
                            <i class="fa-solid fa-book-quran"></i> Pendidikan Agama Islam & Budi Pekerti
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                            Evaluasi Ketentuan Penyembelihan Hewan, Kurban, & Akikah
                        </h2>
                        <p class="mt-2 text-white/90 text-sm sm:text-base leading-relaxed">
                            Selamat datang, Santri SMP DAFI! Kerjakan kuis ini dengan jujur, teliti, dan penuh tanggung jawab sebagai wujud pengamalan nilai amanah.
                        </p>
                    </div>
                    <i class="fa-solid fa-kaaba text-white/10 text-9xl absolute -right-4 -bottom-6 pointer-events-none"></i>
                </div>

                <div class="p-6 sm:p-8 space-y-6">
                    <!-- Petunjuk Pengerjaan -->
                    <div class="bg-gray-50 rounded-xl p-4 sm:p-5 border border-gray-200">
                        <h3 class="font-bold text-gray-800 flex items-center gap-2 text-sm sm:text-base mb-3">
                            <i class="fa-solid fa-circle-info text-dafi-red"></i>
                            Petunjuk & Aturan Pengerjaan Kuis
                        </h3>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs sm:text-sm text-gray-600">
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span>Jumlah soal: <strong>25 Pilihan Ganda</strong> (A, B, C, D).</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span>Setiap jawaban benar bernilai <strong>4 poin</strong> (Maksimal 100).</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span>Standar Ketuntasan Minimal (KKM): <strong>Nilai ≥ 80 (TUNTAS)</strong>.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span>Urutan soal <strong>diacak otomatis</strong> untuk setiap sesi santri.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span><strong>Semua 25 soal wajib dijawab</strong> sebelum dapat dikumpulkan.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fa-solid fa-check text-dafi-red mt-1 shrink-0"></i>
                                <span>Setelah dikumpulkan, jawaban terkunci dan langsung tersimpan ke Google Sheets Guru.</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Alert Jika Google Sheets Belum Diisi -->
                    <div id="unconfiguredWarning" class="hidden bg-amber-50 border border-amber-300 rounded-xl p-4 text-amber-900 text-xs sm:text-sm flex items-start justify-between gap-3">
                        <div class="flex items-start gap-2.5">
                            <i class="fa-solid fa-triangle-exclamation text-amber-600 text-base mt-0.5 shrink-0"></i>
                            <div>
                                <p class="font-bold">Perhatian untuk Guru: URL Google Apps Script Belum Dipasang</p>
                                <p class="mt-0.5 text-amber-800">Kuis tetap dapat diuji coba, namun untuk mengirim nilai langsung ke Google Sheets, silakan klik tombol <strong>Konfigurasi Sheets</strong> di kanan atas atau masukkan URL pada variabel <code>DEFAULT_SCRIPT_URL</code>.</p>
                            </div>
                        </div>
                        <button type="button" onclick="openConfigModal()" class="shrink-0 bg-amber-600 hover:bg-amber-700 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">
                            Atur URL
                        </button>
                    </div>

                    <!-- Form Identitas Siswa -->
                    <form id="startForm" onsubmit="handleStartQuiz(event)" class="space-y-5" novalidate>
                        <div>
                            <label for="inputStudentName" class="block text-sm font-bold text-gray-700 mb-1.5">
                                Nama Lengkap Santri <span class="text-dafi-red">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400">
                                    <i class="fa-solid fa-user"></i>
                                </span>
                                <input
                                    type="text"
                                    id="inputStudentName"
                                    placeholder="Contoh: Ahmad Fauzan Al-Farisi"
                                    autocomplete="name"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-300 focus:border-dafi-red focus:ring-2 focus:ring-dafi-red/20 outline-none transition text-gray-800 font-medium text-sm sm:text-base"
                                    required
                                >
                            </div>
                            <p id="errStudentName" class="hidden text-xs text-dafi-red font-semibold mt-1.5 flex items-center gap-1">
                                <i class="fa-solid fa-circle-exclamation"></i> Nama lengkap santri wajib diisi (minimal 3 karakter).
                            </p>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2">
                                Pilih Kelas <span class="text-dafi-red">*</span>
                            </label>
                            <div class="grid grid-cols-3 gap-3" id="classSelectionGroup">
                                <label class="cursor-pointer">
                                    <input type="radio" name="studentClass" value="9A" class="peer sr-only" onchange="clearValidationErrors()">
                                    <div class="text-center py-3.5 px-4 rounded-xl border-2 border-gray-200 bg-white font-bold text-gray-700 peer-checked:border-dafi-red peer-checked:bg-dafi-lightred peer-checked:text-dafi-red hover:border-gray-300 transition flex flex-col items-center">
                                        <span class="text-lg">9A</span>
                                        <span class="text-[11px] font-medium text-gray-500 peer-checked:text-dafi-red">Kelas IX-A</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="studentClass" value="9B" class="peer sr-only" onchange="clearValidationErrors()">
                                    <div class="text-center py-3.5 px-4 rounded-xl border-2 border-gray-200 bg-white font-bold text-gray-700 peer-checked:border-dafi-red peer-checked:bg-dafi-lightred peer-checked:text-dafi-red hover:border-gray-300 transition flex flex-col items-center">
                                        <span class="text-lg">9B</span>
                                        <span class="text-[11px] font-medium text-gray-500 peer-checked:text-dafi-red">Kelas IX-B</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="studentClass" value="9C" class="peer sr-only" onchange="clearValidationErrors()">
                                    <div class="text-center py-3.5 px-4 rounded-xl border-2 border-gray-200 bg-white font-bold text-gray-700 peer-checked:border-dafi-red peer-checked:bg-dafi-lightred peer-checked:text-dafi-red hover:border-gray-300 transition flex flex-col items-center">
                                        <span class="text-lg">9C</span>
                                        <span class="text-[11px] font-medium text-gray-500 peer-checked:text-dafi-red">Kelas IX-C</span>
                                    </div>
                                </label>
                            </div>
                            <p id="errStudentClass" class="hidden text-xs text-dafi-red font-semibold mt-1.5 flex items-center gap-1">
                                <i class="fa-solid fa-circle-exclamation"></i> Silakan pilih kelas terlebih dahulu (9A, 9B, atau 9C).
                            </p>
                        </div>

                        <div class="pt-2">
                            <button
                                type="submit"
                                class="w-full dafi-gradient hover:opacity-95 text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-dafi-red/25 transition transform active:scale-[0.99] flex items-center justify-center gap-2.5 text-base cursor-pointer"
                            >
                                <span>MULAI KUIS</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- VIEW 2: HALAMAN PENGERJAAN KUIS -->
        <section id="viewQuiz" class="hidden">
            <!-- Top Mobile Student Info & Progress Bar -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-4 mb-5">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                    <div class="flex items-center gap-2">
                        <span id="quizProgressBadge" class="bg-dafi-red text-white text-xs font-extrabold px-3 py-1 rounded-lg">
                            Soal 1 dari 25
                        </span>
                        <span id="answeredCountBadge" class="bg-gray-100 text-gray-700 text-xs font-semibold px-2.5 py-1 rounded-lg border border-gray-200">
                            Terjawab: 0/25
                        </span>
                    </div>
                    <div class="text-xs font-semibold text-gray-500 flex items-center gap-2">
                        <span id="mobileStudentIdentity" class="md:hidden text-gray-700 font-bold"></span>
                    </div>
                </div>
                <!-- Progress Bar -->
                <div class="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden">
                    <div id="quizProgressBar" class="bg-dafi-red h-full transition-all duration-300 rounded-full" style="width: 4%"></div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- Kolom Kiri: Kartu Soal Aktif -->
                <div class="lg:col-span-8 bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden flex flex-col justify-between">
                    <div class="p-5 sm:p-7">
                        <!-- Header Nomor Soal -->
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5">
                            <div class="flex items-center gap-2.5">
                                <span id="currentDisplayNumber" class="w-9 h-9 rounded-xl dafi-gradient text-white font-extrabold flex items-center justify-center text-sm shadow-sm">
                                    1
                                </span>
                                <div>
                                    <span class="text-xs uppercase tracking-wider font-bold text-gray-400 block">Pertanyaan Pilihan Ganda</span>
                                    <span class="text-xs font-semibold text-gray-600">Bobot: 4 Poin</span>
                                </div>
                            </div>
                            <span id="questionAnsweredStatus" class="text-xs font-bold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">
                                Belum Dijawab
                            </span>
                        </div>

                        <!-- Redaksi Soal -->
                        <div class="mb-6">
                            <p id="questionText" class="text-base sm:text-lg font-bold text-gray-800 leading-relaxed select-none">
                                Memuat pertanyaan...
                            </p>
                        </div>

                        <!-- Pilihan Jawaban A, B, C, D -->
                        <div id="optionsContainer" class="space-y-3">
                            <!-- Di-render secara dinamis oleh JavaScript -->
                        </div>
                    </div>

                    <!-- Footer Navigasi Soal Sebelumnya / Selanjutnya -->
                    <div class="bg-gray-50 px-5 sm:px-7 py-4 border-t border-gray-200 flex items-center justify-between gap-3">
                        <button
                            type="button"
                            id="btnPrevQuestion"
                            onclick="navigateQuestion(-1)"
                            class="px-4 py-2.5 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 font-bold text-sm transition flex items-center gap-2 disabled:opacity-40 disabled:pointer-events-none cursor-pointer"
                        >
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                            <span>Sebelumnya</span>
                        </button>

                        <button
                            type="button"
                            id="btnNextQuestion"
                            onclick="navigateQuestion(1)"
                            class="px-5 py-2.5 rounded-xl bg-gray-800 hover:bg-gray-900 text-white font-bold text-sm transition flex items-center gap-2 cursor-pointer"
                        >
                            <span>Selanjutnya</span>
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Kolom Kanan: Navigasi Nomor Soal & Tombol Kumpulkan -->
                <div class="lg:col-span-4 bg-white rounded-2xl shadow-md border border-gray-200 p-5 sticky top-20">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-grip text-dafi-red"></i>
                            Navigasi Nomor Soal
                        </h3>
                        <span id="unansweredCounterText" class="text-xs font-semibold text-dafi-red">25 belum dijawab</span>
                    </div>

                    <!-- Legend -->
                    <div class="flex items-center gap-4 text-[11px] text-gray-500 mb-3 pb-3 border-b border-gray-100">
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded bg-dafi-red inline-block"></span> Sudah Dijawab
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded bg-gray-100 border border-gray-300 inline-block"></span> Belum
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded ring-2 ring-gray-800 inline-block"></span> Aktif
                        </span>
                    </div>

                    <!-- Grid 25 Nomor Soal -->
                    <div id="questionGridNav" class="grid grid-cols-5 gap-2 mb-5">
                        <!-- Di-render oleh JS -->
                    </div>

                    <!-- Pesan Peringatan Jika Belum Lengkap -->
                    <div id="incompleteNotice" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-dafi-red text-xs font-semibold flex items-start gap-2">
                        <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                        <span id="incompleteNoticeText">Masih ada soal yang belum dijawab.</span>
                    </div>

                    <!-- Tombol Kumpulkan Kuis -->
                    <button
                        type="button"
                        id="btnRequestSubmit"
                        onclick="handleRequestSubmit()"
                        class="w-full py-3.5 px-4 rounded-xl dafi-gradient hover:opacity-95 text-white font-extrabold text-sm shadow-md shadow-dafi-red/20 transition flex items-center justify-center gap-2 cursor-pointer"
                    >
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>KUMPULKAN JAWABAN</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- VIEW 3: HALAMAN HASIL & PEMBAHASAN -->
        <section id="viewResult" class="hidden space-y-6 max-w-4xl mx-auto">
            <!-- Status Pengiriman ke Google Sheets -->
            <div id="syncStatusBanner" class="rounded-2xl p-4 sm:p-5 border shadow-sm transition-all">
                <!-- Diisi dinamis oleh JS: Mengirim / Berhasil / Gagal dengan tombol Retry -->
            </div>

            <!-- Kartu Ringkasan Hasil Akhir -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
                <div class="dafi-gradient p-6 sm:p-8 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-widest bg-white/20 px-3 py-1 rounded-full">
                            Hasil Evaluasi Akhir
                        </span>
                        <h2 id="resultStudentName" class="text-2xl sm:text-3xl font-extrabold mt-2">-</h2>
                        <p class="text-white/90 text-sm flex flex-wrap items-center gap-x-4 gap-y-1 mt-1">
                            <span><i class="fa-solid fa-users-rectangle mr-1"></i> Kelas: <strong id="resultStudentClass">-</strong></span>
                            <span><i class="fa-regular fa-clock mr-1"></i> Waktu Kumpul: <strong id="resultTimestamp">-</strong></span>
                        </p>
                    </div>

                    <!-- Badge Nilai Akhir Besar -->
                    <div class="bg-white text-gray-900 rounded-2xl p-4 sm:px-6 text-center shadow-lg shrink-0 flex sm:flex-col items-center justify-between sm:justify-center gap-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Nilai Akhir</span>
                        <div class="text-4xl sm:text-5xl font-black text-dafi-red leading-none" id="resultFinalScore">0</div>
                        <span id="resultPassBadge" class="text-xs font-extrabold px-3 py-1 rounded-full">-</span>
                    </div>
                </div>

                <!-- Grid Statistik Jawaban -->
                <div class="p-6 grid grid-cols-2 sm:grid-cols-4 gap-4 bg-gray-50 border-b border-gray-200">
                    <div class="bg-white p-4 rounded-xl border border-gray-200 text-center">
                        <span class="text-xs font-semibold text-gray-500 block">Total Soal</span>
                        <span class="text-xl font-extrabold text-gray-800 mt-1 block">25</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-emerald-200 text-center">
                        <span class="text-xs font-semibold text-emerald-700 block">Jawaban Benar</span>
                        <span id="resultCorrectCount" class="text-xl font-extrabold text-emerald-600 mt-1 block">0 / 25</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-red-200 text-center">
                        <span class="text-xs font-semibold text-red-700 block">Jawaban Salah</span>
                        <span id="resultWrongCount" class="text-xl font-extrabold text-dafi-red mt-1 block">0</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-gray-200 text-center">
                        <span class="text-xs font-semibold text-gray-500 block">Status Ketuntasan</span>
                        <span id="resultStatusText" class="text-sm sm:text-base font-extrabold mt-1.5 block">-</span>
                    </div>
                </div>

                <!-- Pesan Motivasi -->
                <div class="p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="flex items-start gap-3">
                        <div id="resultFeedbackIcon" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg"></div>
                        <div>
                            <h4 id="resultFeedbackTitle" class="font-bold text-gray-800 text-sm sm:text-base"></h4>
                            <p id="resultFeedbackDesc" class="text-xs sm:text-sm text-gray-600 mt-0.5"></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bagian Pembahasan 25 Soal -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-5 sm:p-7">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-6 border-b border-gray-200">
                    <div>
                        <h3 class="text-lg font-extrabold text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-check text-dafi-red"></i>
                            Pembahasan Lengkap Setiap Soal (1–25)
                        </h3>
                        <p class="text-xs text-gray-500 mt-0.5">
                            Pelajari kembali pembahasan di bawah ini untuk memahami ketentuan syariat penyembelihan, kurban, dan akikah.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
